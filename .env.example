# EnergyPulse Configuration
# Copy this file to .env and fill in your own values:
#   Windows PowerShell :  copy .env.example .env
#   macOS / Linux      :  cp .env.example .env
#
# .env is listed in .gitignore and is never committed. Every value here is a
# placeholder, so leaving this file as-is keeps the app in "Not configured".

# ---------------------------------------------------------------------------
# EMAIL — Gmail SMTP with an app password (no third-party signup required)
#   The app only needs SMTP_USER and SMTP_PASSWORD. The host, port and TLS
#   below are the defaults, so you can leave them as they are.
#
#   To create the app password:
#     1. Google Account -> Security -> 2-Step Verification  (turn it ON)
#     2. Google Account -> Security -> App Passwords -> "Mail"
#     3. Copy the 16-character app password into SMTP_PASSWORD below
#
#   SMTP_FROM is optional: when it is blank, mail is sent from SMTP_USER.
#   SMTP_USERNAME is accepted as an older alias for SMTP_USER.
# ---------------------------------------------------------------------------
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=

# STARTTLS is on by default, which is what port 587 expects. Port 465 uses
# implicit TLS and is detected automatically. Set either to false only if
# your provider has told you to.
#SMTP_STARTTLS=true
#SMTP_USE_SSL=false

# ---------------------------------------------------------------------------
# EMAIL — alternative: SendGrid
#   Use EITHER this OR the SMTP block above, not both. When both are set the
#   app prefers SendGrid.
#   Create a free account at sendgrid.com and paste the API key here.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ---------------------------------------------------------------------------
# SMS — optional, Twilio
#   Leaving these blank is normal: SMS then shows "Optional - not configured"
#   and every alert is delivered by email only.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
